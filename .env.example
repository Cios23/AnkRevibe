# Copy to .env.local and fill in from Supabase dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- eBay -------------------------------------------------------------
# Targets production (api.ebay.com) unless EBAY_ENV=sandbox.
EBAY_ENV=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD

# From the eBay developer console -> your application keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (eBay Redirect URL name), NOT an https:// URL.
EBAY_RUNAME=

# Written automatically by `npm run ebay:auth`. Lasts ~18 months; access
# tokens are minted from it on demand.
EBAY_REFRESH_TOKEN=

# Optional escape hatch: a manually pasted 2-hour token from the console.
# Only used when EBAY_REFRESH_TOKEN is absent. Not for normal operation.
EBAY_USER_ACCESS_TOKEN=

# Business policy defaults - populate by running `npm run ebay:policies`.
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# An inventory location key you have created on the eBay account.
# Required to publish an offer.
EBAY_MERCHANT_LOCATION_KEY=

# Set to true to route eBay through the fake adapter for local work.
EBAY_USE_STUB=
