{
  "manifest_version": 3,
  "name": "AnK ReVibe Crosslister",
  "version": "0.1.0",
  "description": "Crosslist AnK ReVibe inventory to Poshmark and Depop, with auto-share, auto-offer and Depop relist.",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://poshmark.com/*",
    "https://*.poshmark.com/*",
    "https://www.depop.com/*",
    "https://bmgjqnrazdfgjcbmtasp.supabase.co/*",
    "https://i.ebayimg.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*"
      ],
      "js": [
        "content-scripts/ankrevibe.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poshmark.com/create-listing*",
        "https://*.poshmark.com/create-listing*"
      ],
      "js": [
        "lib/dom.js",
        "lib/dropdown.js",
        "content-scripts/poshmark.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poshmark.com/closet*",
        "https://*.poshmark.com/closet*",
        "https://poshmark.com/listings*",
        "https://*.poshmark.com/listings*"
      ],
      "js": [
        "automation/poshmark-share.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poshmark.com/closet*",
        "https://*.poshmark.com/closet*",
        "https://poshmark.com/listing/*",
        "https://*.poshmark.com/listing/*",
        "https://poshmark.com/offer*",
        "https://*.poshmark.com/offer*"
      ],
      "js": [
        "lib/margin.js",
        "automation/offer-sender.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.depop.com/products/create*"
      ],
      "js": [
        "lib/dom.js",
        "content-scripts/depop.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.depop.com/products/*"
      ],
      "js": [
        "lib/labels.js",
        "automation/depop-delist.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
